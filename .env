# Copy this file to .env and fill in your real values.
# Never commit your real .env file to version control.

# ----- Old (source / baseline) database -----
OLD_DB_HOST=localhost
OLD_DB_PORT=5432
OLD_DB_NAME=er
OLD_DB_USER=postgres
OLD_DB_PASSWORD=bel123

# ----- New (target / updated) database -----
NEW_DB_HOST=localhost
NEW_DB_PORT=5432
NEW_DB_NAME=INDUSTRY4.0TEST
NEW_DB_USER=postgres
NEW_DB_PASSWORD=bel123

# ----- Optional settings -----
# PostgreSQL schema to compare (defaults to "public")
PG_SCHEMA=public

# Where reports are written (defaults to "reports")
REPORTS_DIR=reports
JSON_REPORT_NAME=schema_diff.json
HTML_REPORT_NAME=schema_diff.html
